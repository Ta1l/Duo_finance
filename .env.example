# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Строка подключения (SQLAlchemy async URL)
DATABASE_URL=sqlite+aiosqlite:///./duo_finance.db

# Стартовый долг каждого игрока
START_DEBT=300000

# Окно N дней для средне-дневного платежа в долг и ETA (14 или 30)
ETA_WINDOW_DAYS=14

# Время ежедневного опроса (МСК)
SURVEY_HOUR=23
SURVEY_MINUTE=30

# Час уведомления о выплате «в пути» по четвергам (МСК)
PAYOUT_HOUR=12

# Прокси для Telegram (SOCKS5)
# PROXY_URL=socks5://user:pass@host:port
